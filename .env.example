# KitchenSync backend environment template.
# Copy to .env and fill in real values. Never commit .env.
# Values here are intentionally EMPTY: allowed values / defaults are in the comments.
# Code must treat an unset boolean as false (fail closed) and an unset numeric as its comment default.

# --- App ---
APP_ENV=                            # development | production
API_BASE_URL=
ALLOWED_HOSTS=                      # comma-separated; exact hosts only, no wildcards
DOCS_ENABLED=                       # false in production: disables /docs and /openapi.json
LOG_LEVEL=                          # DEBUG | INFO | WARNING | ERROR
REQUEST_MAX_BODY_MB=                # default 10

# --- Database ---
DATABASE_URL=                       # limited-privilege app user: postgresql://kitchensync_app:***@host:5432/kitchensync
DATABASE_ADMIN_URL=                 # migrations only: postgresql://kitchensync_admin:***@host:5432/kitchensync
GRAPH_DB_URL=                       # graph/vector recipe store
GRAPH_DB_TOKEN=
REDIS_URL=                          # rate limits, short-lived caches, membership cache

# --- Auth (Google sign-in + our tokens) ---
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_WEB=               # needed for server-side Gmail/Calendar token exchange
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
JWT_SIGNING_SECRET=                 # >= 32 random bytes
JWT_SIGNING_SECRET_PREVIOUS=        # optional, for rotation window
JWT_ALGORITHM=                      # fixed HS256; never read from the token
JWT_ISSUER=                         # default kitchensync-api
JWT_AUDIENCE=                       # default kitchensync-app
ACCESS_TOKEN_TTL_MIN=               # default 15
REFRESH_TOKEN_TTL_DAYS=             # default 30
REFRESH_TOKEN_HASH_PEPPER=          # for hashing refresh tokens before storing
MEMBERSHIP_CACHE_SECONDS=           # default 60

# --- Encryption of stored third-party tokens ---
TOKEN_ENCRYPTION_KEYS=              # id:key pairs, e.g. k1:base64...,k2:base64...
TOKEN_ENCRYPTION_ACTIVE_KEY_ID=     # e.g. k1

# --- AI providers (server-side only) ---
GEMINI_API_KEY=                     # Omnirush agent + receipt OCR / fridge scan
GEMINI_AGENT_MODEL=                 # gemini-3-flash-preview (see docs: gemini-3.8-flash is the stable Flash)
GEMINI_AGENT_TIMEOUT_SECONDS=       # default 30
GEMINI_AGENT_MAX_RETRIES=           # default 2
GEMINI_MODEL=                       # receipt OCR / fridge scan model id
SARVAM_API_KEY=                     # cloud speech fallback (Saaras v3)
SARVAM_STT_MODEL=                   # exact model id from Sarvam docs
EXTERNAL_CALL_TIMEOUT_SECONDS=      # default 20

# --- Gemini Interactions API settings for the Omnirush agent (verified against Google docs, Oct 2026) ---
GEMINI_THINKING_LEVEL=              # minimal | low | medium | high (Flash defaults to high; low suits chat)
GEMINI_MAX_OUTPUT_TOKENS=           # hard cap per call; Flash max output is 64k
GEMINI_STORE=                       # false: the API stores interactions by default (55 days paid / 1 day free)

# --- Swiggy Instamart MCP (cart only) ---
SWIGGY_MCP_URL=
SWIGGY_MCP_CLIENT_ID=               # needs builder approval / allowlist
SWIGGY_OAUTH_REDIRECT_URI=
SWIGGY_ALLOWED_TOOLS=               # add_to_cart,track_order,get_orders,get_order_details  (no checkout/place-order tool)

# --- Gmail / Calendar ---
GMAIL_SCOPES=                       # https://www.googleapis.com/auth/gmail.readonly
CALENDAR_SCOPES=                    # narrowest scope that works for app-created events
GMAIL_ORDER_SENDERS=                # allow-list of Blinkit/Zepto/Swiggy sender addresses
GOOGLE_TEST_USERS_ONLY=             # true while sensitive-scope verification is pending

# --- Uploads and storage ---
UPLOAD_MAX_IMAGE_MB=                # default 8
UPLOAD_ALLOWED_TYPES=               # image/jpeg,image/png,image/webp
UPLOAD_MAX_LONG_SIDE_PX=            # default 1600
VIDEO_MAX_FRAMES=                   # default 5
STORAGE_BUCKET=                     # private bucket
STORAGE_SIGNED_URL_TTL_SECONDS=     # default 300
MEDIA_RETENTION_HOURS=              # 24 to 168 (7 days)

# --- AI safety and cost controls ---
LLM_WRITES_ENABLED=                 # kill switch for all AI-driven writes
SCRAPERS_ENABLED=                   # kill switch for Blinkit/Zepto scrapers
GMAIL_PARSING_ENABLED=              # kill switch
SWIGGY_CART_ENABLED=                # kill switch
PENDING_ACTION_TTL_MIN=             # 15 to 30, default 20
INPUT_MAX_CHARS=                    # default 4000; cap before normalization/screening
OUTPUT_MAX_CHARS=                   # default 5000
AGENT_MAX_ITEMS_PER_PROPOSAL=       # default 25
DAILY_EXPENSIVE_CALLS_PER_HOUSEHOLD= # default 100

# --- Rate limits (per minute) ---
RATE_LIMIT_AUTH_PER_MIN=            # default 10
RATE_LIMIT_EXPENSIVE_PER_MIN=       # default 20
RATE_LIMIT_DEFAULT_PER_MIN=         # default 120

# --- Monitoring ---
SENTRY_DSN=
AUDIT_LOG_RETENTION_DAYS=           # default 90
ALERT_WEBHOOK_URL=
