# KitchenSync Flutter app: PUBLIC values only.
# Pass at build time: --dart-define=API_BASE_URL=... --dart-define=APP_ENV=...
# or drive them from a build config file. Nothing here is secret.
#
# Never ship any of these to the app: OPENAI_API_KEY, GEMINI_API_KEY, SARVAM_API_KEY,
# GOOGLE_CLIENT_SECRET, JWT_SIGNING_SECRET, SWIGGY_MCP_CLIENT_ID, or any Swiggy secret.
# If any of them already exist in the app tree, delete them and rotate the key.

API_BASE_URL=
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_IOS=
APP_ENV=                            # development | production
